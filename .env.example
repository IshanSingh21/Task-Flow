# ==============================================
# TaskFlow Docker Compose Environment Variables
# Copy this file to .env before starting containers
# ==============================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=taskflow
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# Backend Configuration
BACKEND_PORT=5000
JWT_SECRET=supersecretproductionreadyjwtkeythatshouldbechangedinproduction12345
NODE_ENV=production

# Frontend Configuration
FRONTEND_PORT=3000
